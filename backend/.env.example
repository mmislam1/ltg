NODE_ENV=development
PORT=8000
MONGODB_URI=mongodb://localhost:27017/ltg
CORS_ORIGINS=http://localhost:3000

# Generate independent, high-entropy values of at least 32 characters.
JWT_ACCESS_SECRET=replace-with-a-long-random-access-token-secret
JWT_REFRESH_SECRET=replace-with-a-different-long-random-refresh-secret
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

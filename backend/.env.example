NODE_ENV=development
PORT=8000
MONGODB_URI=mongodb://localhost:27017/ltg
CORS_ORIGINS=http://localhost:3000

# Generate independent, high-entropy values of at least 32 characters.
JWT_ACCESS_SECRET=replace-with-a-long-random-access-token-secret
JWT_REFRESH_SECRET=replace-with-a-different-long-random-refresh-secret
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Email settings used by POST /api/diet-chart-exports/requests and admin approval.
# On hosts where SMTP is blocked, set RESEND_API_KEY and use a verified MAIL_FROM.
RESEND_API_KEY=
MAIL_HOST=smtp.example.com
MAIL_PORT=587
MAIL_SECURE=false
MAIL_USER=your-smtp-user
MAIL_PASSWORD=your-smtp-password
MAIL_FROM=Lose To Gain <no-reply@example.com>

# Enables POST /api/custom/foods/scan-label. Keep the Gemini key server-side.
NUTRITION_LABEL_SCAN_ENABLED=false
GEMINI_API_KEY=
GEMINI_NUTRITION_MODEL=gemini-3.5-flash

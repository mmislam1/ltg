# Optional UI theme overrides. Values may be any valid CSS color.
# The application uses the green, white, and gray defaults when these are unset.
NEXT_PUBLIC_THEME_PRIMARY=#166534
NEXT_PUBLIC_THEME_PRIMARY_HOVER=#14532d
NEXT_PUBLIC_THEME_PRIMARY_ACTIVE=#052e16
NEXT_PUBLIC_THEME_PRIMARY_SOFT=#dcfce7
NEXT_PUBLIC_THEME_ON_PRIMARY=#ffffff
NEXT_PUBLIC_THEME_BACKGROUND=#f8faf9
NEXT_PUBLIC_THEME_SURFACE=#ffffff
NEXT_PUBLIC_THEME_TEXT=#1f2937
NEXT_PUBLIC_THEME_MUTED=#6b7280
NEXT_PUBLIC_THEME_BORDER=#d1d5db
NEXT_PUBLIC_THEME_DANGER=#b91c1c

# Use "Comfortaa" to select the bundled default, or provide a CSS font stack.
NEXT_PUBLIC_THEME_FONT_FAMILY=Comfortaa

# NestJS API base URL (omit the trailing slash).
NEXT_PUBLIC_API_URL=https://ltg-84ey.onrender.com/api

# Show the nutrition-label scanner on the custom food page.
NEXT_PUBLIC_NUTRITION_LABEL_SCAN_ENABLED=false
